# Public build-time configuration only. Anything prefixed VITE_ is visible in
# the browser bundle — never put secrets here.
#
# Local development uses the Vite dev proxy (vite.config.js -> /api ->
# http://localhost:5000), so no variable is required during dev.
#
# GCE single-domain deployment (Nginx proxies "/" to the Node backend, which
# serves client/dist): leave VITE_API_URL unset so the client uses same-origin
# "/api".
#
# Separate frontend host only: point the app at the backend public URL. The value
# must end with /api; the client appends endpoint paths to it.
# VITE_API_URL=https://your-domain.example/api
