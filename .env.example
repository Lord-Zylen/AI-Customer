# ============================================================================
# Customer AI — environment template
#
# Defaults below target the Google Compute Engine VM (Ubuntu, systemd + Nginx,
# backend on 127.0.0.1:9119 behind Nginx). For local development change PORT to
# 5000 and CAI_HOOK_BASE_URL to http://127.0.0.1:5000 to match the Vite proxy.
#
# Copy this file to the repository-root .env and fill in the blank secrets.
# NEVER commit the real .env or put real secrets in this template. The Node
# backend and the Hermes gateway both read this same file; dotenv does not
# override variables already exported by systemd.
# ============================================================================

# --- Node backend -----------------------------------------------------------
NODE_ENV=production
# Bind on all interfaces; Nginx proxies to 127.0.0.1:9119 on the same VM.
# Do not open 9119 in the GCP firewall.
HOST=0.0.0.0
PORT=9119
# Nginx is one trusted reverse-proxy hop (sets X-Forwarded-For/Proto).
TRUST_PROXY=1

# MongoDB Atlas (external; never installed on the VM).
MONGODB_URI=

# --- Redis (optional) -------------------------------------------------------
# Leave blank to run without Redis. Redis-backed inbound markers, human-queue
# markers and per-chat rate limiting are disabled when this is blank. Provide a
# full redis:// or rediss:// URL to enable them.
REDIS_URL=
# Optional Redis behavior knobs (defaults shown).
# REDIS_QUEUE_TTL=3600
# REDIS_PROCESSING_TTL=120
# REDIS_HUMAN_TTL=604800
# REDIS_RATE_LIMIT=60
# REDIS_RATE_WINDOW_SEC=60

# Long random string used to sign dashboard login tokens. REQUIRED.
SESSION_SECRET=

# --- AI / Hermes provider ---------------------------------------------------
# The backend no longer calls Groq directly; GROQ_API_KEY below is what Hermes
# uses for reply generation. AI_API_KEY is retained only for older installs and
# the system-status check.
AI_API_KEY=
GROQ_API_KEY=

# How long a "reply YES to confirm" prompt stays valid for a short reply.
# ORDER_CONFIRMATION_CONTEXT_MS=1800000
# How long an order draft/confirmation state survives (default 15 minutes).
# ORDER_CONFIRMATION_TTL_MS=900000

# --- Paystack payments ------------------------------------------------------
# REQUIRED for payment links. Use a TEST key (sk_test_...) until live payments
# are explicitly approved. Never expose this key to the frontend or the prompt.
PAYSTACK_SECRET_KEY=
# The server-side catalogue is priced in GHS; keep this as GHS.
PAYSTACK_CURRENCY=GHS
# Receipt email used when the customer has not provided one. Replace with a real
# business inbox before accepting payments.
PAYSTACK_DEFAULT_EMAIL=orders@example.com
# Optional HTTPS page the customer returns to after paying, e.g.
# https://your-domain.example/orders
PAYSTACK_CALLBACK_URL=
# How long (ms) an unused payment link may be reused for the same chat/basket
# fingerprint instead of creating a second transaction (default 30 minutes).
# PAYSTACK_LINK_REUSE_MS=1800000
# Optional API override/timeout (defaults shown).
# PAYSTACK_BASE_URL=https://api.paystack.co
# PAYSTACK_TIMEOUT_MS=15000
# Payment-link delivery and PAID-confirmation retry controls. Confirmations are
# tracked separately from payment truth; failures never reverse a PAID order.
# PAYMENT_LINK_MAX_DELIVERY_ATTEMPTS=5
# PAYMENT_LINK_DELIVERY_LOCK_MS=60000
# PAYMENT_NOTIFICATION_MAX_ATTEMPTS=5
# PAYMENT_NOTIFICATION_LOCK_MS=60000
# PAYMENT_NOTIFICATION_RETRY_AFTER_MS=60000
# PAYMENT_NOTIFICATION_RETRY_INTERVAL_MS=60000

# --- Hermes integration -----------------------------------------------------
HERMES_ENABLED=true
# Leave blank to use the running user's ~/.hermes. The GCE systemd units set
# these explicitly to /home/wisest569/.hermes.
HERMES_HOME=
# HERMES_GATEWAY_STATE defaults to $HERMES_HOME/gateway_state.json when blank.
HERMES_GATEWAY_STATE=
# HERMES_BIN defaults to "hermes" on PATH when blank.
HERMES_BIN=
HERMES_STATE_STALE_MS=300000
# Optional voice-note cache directory (defaults to $HERMES_HOME/audio_cache).
# HERMES_AUDIO_CACHE_DIR=

# Shared secret for Hermes gateway <-> Customer AI webhooks. REQUIRED: if unset,
# the Hermes gate refuses all non-operator WhatsApp messages (fail closed).
CAI_HOOK_SECRET=
# The backend runs on 9119 on the GCE VM. Must match PORT above.
CAI_HOOK_BASE_URL=http://127.0.0.1:9119
# Minimum seconds between "service unavailable" notices to the same chat.
# CAI_GATE_NOTICE_INTERVAL=300
# Gate/payment/voice timeouts used by the Hermes plugin (defaults shown).
# CAI_HOOK_TIMEOUT=4.0
# CAI_PAYMENT_TIMEOUT=60.0
# CAI_VOICE_STT_TIMEOUT=20.0
# CAI_VOICE_MAX_BYTES=15728640
# CAI_VOICE_MAX_SECONDS=300
# CAI_VOICE_MAX_ACTIVE_STT_JOBS=1
# CAI_VOICE_STT_INFLIGHT_TTL=600

# Optional Hermes dashboard proxy. Keep disabled unless you run the Hermes
# dashboard separately. It MUST use a different port from the backend (9120).
# HERMES_DASHBOARD=false
# HERMES_DASHBOARD_PORT=9120

# Comma-separated browser origins allowed to call the API. Set this to the
# public frontend URL(s), e.g. https://your-domain.example. Same-origin Nginx
# deployments work even if this is left at the local default.
CLIENT_ORIGIN=http://localhost:5173

# --- Admin bootstrap --------------------------------------------------------
# Used only by `npm run seed --prefix server`. WARNING: that script deletes all
# users, customers, conversations, messages and business settings before
# seeding. Run it only against a new, empty database. Never run it in production
# after real data exists.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opt-in print of the password at seed time (set to "true" only where safe).
SEED_PRINT_CREDENTIALS=false
# Development-only demo data; ignored in production.
SEED_DEMO=false

# Legacy WhatsApp pairing token (all /api/whatsapp pairing endpoints answer
# "managed by Hermes"). Keep blank unless a legacy client needs it.
WHATSAPP_SETUP_TOKEN=

# --- Hermes gateway (same environment on the same VM) ----------------------
WHATSAPP_ENABLED=true
WHATSAPP_ALLOW_ALL_USERS=false
# Comma-separated allow-list when WHATSAPP_ALLOW_ALL_USERS=false. Hermes and
# Customer AI must agree; the gate also handles customer decisions.
WHATSAPP_ALLOWED_USERS=
# Operator WhatsApp chat id (for example 3247...@lid) that bypasses the AI gate.
WHATSAPP_HOME_CHANNEL=

# --- Frontend build (build-time, public) -----------------------------------
# The Express server serves client/dist and Nginx proxies "/" to the backend, so
# no VITE_API_URL is needed for a single-domain deployment. Set it only when the
# frontend is hosted separately; it must end in /api.
# VITE_API_URL=https://your-domain.example/api
