# ============================================================================
# Customer AI - environment template (production deployment)
#
# Copy this file to the VPS as `.env` for the Node backend. The Hermes
# daemon reads its own variables from `~/.hermes/.env` on the same VPS
# (section below, listed for reference only). The Vercel frontend only ever
# receives VITE_API_URL (public). NEVER commit real secret values.
# ============================================================================

# --- Customer AI Node backend (VPS) ----------------------------------------
NODE_ENV=production
HOST=127.0.0.1
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster0.example.mongodb.net/customer_ai

# Session signing secret (long, random)
SESSION_SECRET=replace-with-a-long-random-secret

# AI classification (Groq client used by the backend)
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_CONFIDENCE_THRESHOLD=0.75

# Hermes integration (backend side)
HERMES_ENABLED=true
HERMES_HOME=/home/<vps-user>/.hermes
HERMES_GATEWAY_STATE=/home/<vps-user>/.hermes/gateway_state.json
HERMES_BIN=/home/<vps-user>/.local/bin/hermes
HERMES_STATE_STALE_MS=300000

# Shared secret for Hermes <-> Customer AI webhooks (plugin + mirror hooks)
CAI_HOOK_SECRET=

# Comma-separated list of allowed frontend origins (production + local dev)
CLIENT_ORIGIN=https://customer-ai.vercel.app,http://localhost:5173

# Production admin bootstrap (used only by `npm run seed --prefix server`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_PRINT_CREDENTIALS=false

# Legacy WhatsApp pairing token (endpoints always answer "managed by Hermes")
WHATSAPP_SETUP_TOKEN=

# --- Hermes on the SAME VPS (~/.hermes/.env) -------------------------------
# These are NOT read by the Node backend; they configure the Hermes daemon.
# Keep them on the VPS only.
GROQ_API_KEY=
WHATSAPP_ENABLED=true
WHATSAPP_ALLOW_ALL_USERS=false
WHATSAPP_ALLOWED_USERS=
WHATSAPP_HOME_CHANNEL=
CAI_HOOK_BASE_URL=http://127.0.0.1:5000

# --- Vercel frontend (build-time, public) ----------------------------------
# Provided in the Vercel project settings (or client/.env.local for local
# prod-like previews). Never place backend secrets here.
# VITE_API_URL=https://api.example.com/api