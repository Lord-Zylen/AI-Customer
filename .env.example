# ============================================================================
# Customer AI — environment template (Render production)
#
# These variables are set in the Render service environment; the Node backend
# AND the Hermes gateway run in the same container and share them. NEVER put
# real secrets in this file or anywhere in git. Vercel only ever receives
# VITE_API_URL (public, see client/.env.example).
# ============================================================================

# --- Node backend -----------------------------------------------------------
NODE_ENV=production
# Render binds its managed networks; the container must listen on 0.0.0.0.
HOST=0.0.0.0
# Render injects PORT automatically (reserved) — do NOT set it here.
# The image defaults to 8080 only as a local-Docker fallback.
# Numbers of trusted reverse-proxy hops (1 = Render's proxy sets X-Forwarded-For).
TRUST_PROXY=1

# MongoDB Atlas (external; never installed in the container).
MONGODB_URI=

# --- Redis Cloud (external managed Redis; never installed in the container) --
# Full URL including user + password, e.g.
#   REDIS_URL=redis://default:YOUR_PASSWORD@<host>.db.redis.io:14861
# The password lives only in the runtime environment, never in git.
REDIS_URL=
# Optional Redis behavior knobs (defaults shown).
REDIS_QUEUE_TTL=3600            # seconds an inbound-queue record/marker survives
REDIS_PROCESSING_TTL=120        # seconds an in-flight processing marker survives
REDIS_HUMAN_TTL=604800          # seconds a human-queue marker survives (7 days)
REDIS_RATE_LIMIT=60             # max inbound messages per chat per window
REDIS_RATE_WINDOW_SEC=60        # rate-limit window length (seconds)

# Session signing secret (long, random).
SESSION_SECRET=

# AI classification (Groq client used by the backend).
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_CONFIDENCE_THRESHOLD=0.75

# --- Hermes integration (backend side) --------------------------------------
HERMES_ENABLED=true
# Persistent data lives on the Render Persistent Disk mounted at /app/data.
HERMES_HOME=/app/data/hermes
HERMES_GATEWAY_STATE=/app/data/hermes/gateway_state.json
HERMES_BIN=/home/customerai/.local/bin/hermes
HERMES_STATE_STALE_MS=300000
# WhatsApp auth (legacy-token env; the Hermes bridge session persists under
# $HERMES_HOME/whatsapp). Both live on the /app/data disk.
WHATSAPP_AUTH_DIR=/app/data/whatsapp-auth

# Shared secret for Hermes gateway <-> Customer AI webhooks (same container).
CAI_HOOK_SECRET=
# Optional. If unset the entrypoint derives it from $PORT
# (http://127.0.0.1:<PORT>), which is required because Render's PORT is
# dynamic — no longer hardcode 8080 here.
CAI_HOOK_BASE_URL=

# Comma-separated list of allowed frontend origins (the Vercel domain).
CLIENT_ORIGIN=https://<vercel-domain>

# Admin bootstrap (used only by `npm run seed --prefix server`).
# Configured credentials always win and are the only admin created when set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opt-in print of the password at seed time (set to "true" only where safe).
SEED_PRINT_CREDENTIALS=false
# Development-only: create the demo admin (admin@customer-ai.test /
# ChangeMe123!) only when true AND NODE_ENV is not production. Never created
# when ADMIN_EMAIL + ADMIN_PASSWORD are set, and never in production.
SEED_DEMO=false

# Legacy WhatsApp pairing token (endpoints always answer "managed by Hermes").
WHATSAPP_SETUP_TOKEN=

# --- Hermes gateway (same container, same environment) ----------------------
# NOTE: the backend reads AI_API_KEY (Groq); Hermes reads GROQ_API_KEY from
# config.yaml. Provide both.
GROQ_API_KEY=
WHATSAPP_ENABLED=true
WHATSAPP_ALLOW_ALL_USERS=false
WHATSAPP_ALLOWED_USERS=
# Operator WhatsApp chat id (e.g. 3247...@lid); bypasses the AI gate.
WHATSAPP_HOME_CHANNEL=

# --- Vercel frontend (build-time, public) -----------------------------------
# Provided in the Vercel project settings (or client/.env.local locally).
# VITE_API_URL=https://<render-backend-public-url>/api