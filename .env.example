# ============================================================================
# Customer AI — environment template (Blitz Cloud production)
#
# These variables are set in the Blitz Cloud application environment; the
# Node backend AND the Hermes gateway run in the same container and share
# them. NEVER put real secrets in this file or anywhere in git. Vercel only
# ever receives VITE_API_URL (public).
# ============================================================================

# --- Node backend -----------------------------------------------------------
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
# Numbers of trusted reverse-proxy hops (1 = Blitz/Nginx set X-Forwarded-For).
# Only adjust if Blitz's ingress is multi-hop.
TRUST_PROXY=1

# MongoDB Atlas (external; never installed in the container).
MONGODB_URI=

# Session signing secret (long, random).
SESSION_SECRET=

# AI classification (Groq client used by the backend).
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_CONFIDENCE_THRESHOLD=0.75

# --- Hermes integration (backend side) --------------------------------------
HERMES_ENABLED=true
HERMES_HOME=/home/customerai/.hermes
HERMES_GATEWAY_STATE=/home/customerai/.hermes/gateway_state.json
HERMES_BIN=/home/customerai/.local/bin/hermes
HERMES_STATE_STALE_MS=300000

# Shared secret for Hermes gateway <-> Customer AI webhooks (same container).
CAI_HOOK_SECRET=
CAI_HOOK_BASE_URL=http://127.0.0.1:8080

# Comma-separated list of allowed frontend origins (Vercel).
CLIENT_ORIGIN=https://<vercel-domain>

# Production admin bootstrap (used only by `npm run seed --prefix server`).
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_PRINT_CREDENTIALS=false

# Legacy WhatsApp pairing token (endpoints always answer "managed by Hermes").
WHATSAPP_SETUP_TOKEN=

# --- Hermes gateway (same container, same environment) ----------------------
GROQ_API_KEY=
WHATSAPP_ENABLED=true
WHATSAPP_ALLOW_ALL_USERS=false
WHATSAPP_ALLOWED_USERS=
# Operator WhatsApp chat id (e.g. 3247...@lid); bypasses the AI gate.
WHATSAPP_HOME_CHANNEL=

# --- Vercel frontend (build-time, public) -----------------------------------
# Provided in the Vercel project settings (or client/.env.local locally).
# VITE_API_URL=https://<blitz-public-domain>/api