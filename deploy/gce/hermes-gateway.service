# Hermes Agent gateway (WhatsApp transport owner) — Google Compute Engine.
# Install to /etc/systemd/system/hermes-gateway.service.
#
# Hermes and Customer AI share one .env so CAI_HOOK_SECRET and GROQ_API_KEY are
# identical for both processes. Only the gateway owns the WhatsApp connection.
[Unit]
Description=Hermes Agent Gateway - WhatsApp transport for Customer AI
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=wisest569
Group=wisest569
WorkingDirectory=/home/wisest569/.hermes
EnvironmentFile=/home/wisest569/AI-Customer/.env

Environment="PATH=/home/wisest569/.hermes/hermes-agent/venv/bin:/home/wisest569/.hermes/node/bin:/home/wisest569/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/wisest569/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/wisest569/.hermes"
Environment="HERMES_SUPERVISED_CHILD=1"
Environment="CAI_HOOK_BASE_URL=http://127.0.0.1:9119"

ExecStart=/home/wisest569/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run

Restart=always
RestartSec=5
# Exit 75 asks the supervisor to restart; exit 78 means WhatsApp is enabled but
# not paired yet. Stop instead of looping until pairing is complete.
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-/home/wisest569/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=70
UMask=0077

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
