# ============================================================================
# HERMES-ONLY test deployment — environment template
#
# Copy the VALUES into your platform's environment-variable settings (Blitz /
# Render / docker run). NEVER put real secrets in this file or anywhere in git.
#
# This is the COMPLETE list. It deliberately does NOT include MONGODB_URI,
# REDIS_URL, SESSION_SECRET, AI_API_KEY, CAI_HOOK_SECRET, CAI_HOOK_BASE_URL,
# CLIENT_ORIGIN, VITE_API_URL, TRUST_PROXY, ADMIN_* or any other Customer AI /
# Vite variable: none of those processes run in this image.
# ============================================================================

# --- Dashboard authentication (REQUIRED for a 0.0.0.0 bind) ----------------
# Hermes refuses to start a dashboard on a non-loopback host without a
# DashboardAuthProvider. `--insecure` does NOT bypass this (June 2026
# hardening) — there is no unauthenticated public-dashboard option.
# Set a username and a strong, unique password. You will need these to log in
# to the dashboard and pair WhatsApp.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Optional but recommended: a stable random string so dashboard sessions
# survive a container restart. Without it Hermes generates a random per-process
# key and every restart logs you out. Any string; 32+ random bytes is ideal.
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# --- AI provider (REQUIRED for the agent to answer) -------------------------
# Matched by hermes/configuration/config.yaml -> providers.groq.key_env.
# Without it the gateway still starts and WhatsApp still pairs, but every
# message fails with a 401 from the provider.
GROQ_API_KEY=

# --- WhatsApp (on by default) ------------------------------------------------
# Left ENABLED on purpose: the gateway parks itself (exit 78) until you pair
# from the dashboard. Disabling it would only fake a healthy container.
WHATSAPP_ENABLED=true
# Optional: your own WhatsApp chat id (e.g. 3247...@lid) as the operator/home
# channel. Only meaningful in the combined deployment, where customer-ai-gate
# is active; harmless here.
# WHATSAPP_HOME_CHANNEL=

# --- Dashboard network (optional; the image defaults are already correct) ---
# HERMES_DASHBOARD_HOST=0.0.0.0
# HERMES_DASHBOARD_PORT=9119
# HERMES_DASHBOARD_ENABLED=true

# --- Supervisor tuning (optional; defaults shown) ---------------------------
# How often to retry the gateway while WhatsApp is unpaired (ms).
# GATEWAY_PARK_RETRY_MS=30000
# Crash backoff base / cap (ms).
# GATEWAY_BACKOFF_BASE_MS=15000
# GATEWAY_BACKOFF_MAX_MS=300000
# Grace given to the gateway to flush the WhatsApp session on shutdown (ms).
# GATEWAY_GRACE_MS=70000
# Set to false ONLY to run a dashboard-only container. WhatsApp will not
# connect and pairing will not take effect. The entrypoint/supervisor refuse
# to start without a dashboard.
# GATEWAY_ENABLED=true
